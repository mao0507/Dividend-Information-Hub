# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/dividend_hub"

# JWT secrets
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3000
FRONTEND_URL="http://localhost:5174"

# ── Data Sync ──────────────────────────────────────────────
# Set to "true" to enable scheduled data sync (production)
SYNC_ENABLED=false

# Cron expression for daily price sync (default: weekdays 15:30 Asia/Taipei)
SYNC_CRON="30 15 * * 1-5"

# FinMind API token (optional — increases rate limit from 100 to higher tier)
# Register at https://finmindtrade.com/
FINMIND_TOKEN=

# TWSE MI_INDEX URL (可改為本機 proxy 端點)
# 例如: http://127.0.0.1:8787/twse/mi-index
TWSE_MI_INDEX_URL="https://www.twse.com.tw/rwd/zh/afterTrading/MI_INDEX"

# data-sync 手動回填 API（POST /api/data-sync/backfill/*）驗證用密鑰
# 需與呼叫端 header `x-data-sync-secret` 一致，正式環境務必設定
DATA_SYNC_SECRET="change-me-data-sync-secret"

# 選填：股票清單種子（seed）改用本機 JSON 快照，跳過 TWSE/OpenAPI 呼叫
# 參考 resolveTwseSeedStocks 與 sample-universe.json
SEED_TWSE_LIST_PATH=

# 選填：DB 無資料時是否允許即時觸發 TWSE 同步作為受控 fallback（"true" 才啟用）
STOCK_PRICE_DB_FALLBACK_ENABLED=false
